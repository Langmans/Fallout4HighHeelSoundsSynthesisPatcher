<Project>

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <WarningsAsErrors>nullable</WarningsAsErrors>
    <ImplicitUsings>true</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Noggog's source generator emits an AssemblyVersions type that collides by name with the
         one inside Mutagen.Bethesda.Synthesis. Ours wins and neither is used here. -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>

</Project>
